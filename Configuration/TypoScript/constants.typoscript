plugin.tx_bcsimplerate {
    view {
        # cat=plugin.tx_bcsimplerate/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:bc_simplerate/Resources/Private/Templates/
        # cat=plugin.tx_bcsimplerate/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:bc_simplerate/Resources/Private/Partials/
        # cat=plugin.tx_bcsimplerate/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:bc_simplerate/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Default storage PID
        # storagePid = 
    }
    settings {
        # cat=plugin.tx_bcsimplerate//a; type=string; label=cookiename
        cookiename = rateEntity
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Record ID
        rId = 
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Record Table
        rTable = pages
        # cat=plugin.tx_bcsimplerate//a; type=string; label=feature FE user
        featureFeuser = 
        # cat=plugin.tx_bcsimplerate//a; type=string; label=show records from table
        recordsFromTable = 

        # cat=plugin.tx_bcsimplerate//r; type=int; label=Show type of results: 0|Logged-in Users Only,1|Anonymous Users,2|Current User
        resultType = 
        # cat=plugin.tx_bcsimplerate//r; type=int; label=Show display mode: 0|Detailed, 1|Total Score
        displayMode = 
        # cat=plugin.tx_bcsimplerate//r; type=int; label=Show Top rated
        topRated = 

        # cat=plugin.tx_bcsimplerate//r; type=int; label=Set order BY
        orderBy = uid
        # cat=plugin.tx_bcsimplerate//r; type=int; label=Set order Direction
        orderDirection = DESC 

        # cat=plugin.tx_bcsimplerate//r; type=string; label=Override field via flexfrom settings
        overrideFlexformSettingsIfEmpty = storage,rTable,rId,paginate.insertAbove,paginate.insertBelow,paginate.itemsPerPage,resultType,displayMode,topRated,recordsFromTable,orderDirection,orderBy,limit

        paginate {
            # cat=plugin.tx_bcsimplerate//p; type=int; label=Paginate items per page
            itemsPerPage = 5
            # cat=plugin.tx_bcsimplerate//p; type=int; label=Paginate insert Above
            insertAbove = 0
            # cat=plugin.tx_bcsimplerate//p; type=int; label=Paginate insert Below
            insertBelow = 1
        }
        
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Maximum rate number
        maxRateNumber = 5
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Rate icon HTML
        rateIconHtml = <svg viewBox="0 0 576 512" aria-hidden="true"><path fill="currentColor" d="M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 34.6-17.7 53.7l115.7 112-27.4 158.2c-4.6 26.5 23.2 47.4 46.4 34.1L288 439.6l157.9 82.6c23.2 12.3 51-8.7 46.4-34.1l-27.4-158.2 115.7-112c19-19.1 8.5-49.9-17.7-53.7L382 150.2 316.7 17.8c-11.7-22.6-43.9-22.6-55.6 0z"/></svg>



        
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Submit button icon HTML
        submitButtonIconHtml = 🦅
        # cat=plugin.tx_bcsimplerate//a; type=string; label=Thanks for rating message close icon
        thanksRatingIconHtml = <svg role="button" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M1 13L13 1M1 1L13 13" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>

        # cat=plugin.tx_bcsimplerate//a; type=string; label=ratingLabel
        ratingLabel = Bedøm filmen:
        # cat=plugin.tx_bcsimplerate//a; type=string; label=reviewsLabel
        reviewsLabel = Feedback
        # cat=plugin.tx_bcsimplerate//a; type=string; label=noRatingsLabel
        noRatingsLabel = Be the first to leave a review
        # cat=plugin.tx_bcsimplerate//a; type=string; label=thanksRatingLabel
        thanksRatingLabel = Tak for din bedømmelse
        # cat=plugin.tx_bcsimplerate//a; type=string; label=storage
        storage = 
         
        feature {
            # cat=plugin.tx_bcsimplerate//a; type=string; label=Enable note field
            noteFieldEnabled = 0
            # cat=plugin.tx_bcsimplerate//a; type=string; label=Note field required
            noteFieldRequired = 0
            # cat=plugin.tx_bcsimplerate//a; type=string; label=Note field Label
            noteFieldLabel = Add comment to review
            # cat=plugin.tx_bcsimplerate//a; type=string; label=Enable FE user ratings
            feuser = 1
        }
    }
}
